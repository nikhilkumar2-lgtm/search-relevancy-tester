# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATA_DIR=data

# Google Sheets (optional). Without these the app reads PUBLIC sheets through the CSV export URL.
# Option A: path to the service-account key file
GOOGLE_SERVICE_ACCOUNT_FILE=
# Option B: the key JSON itself (raw or base64)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Print each request (secrets masked) and why a result did or did not match; set to false to silence
DEBUG_REQUESTS=true

# Ground-truth generator: LLM keys (or paste a key in the UI for a single session)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional shared secret. When set, the API (except /api/health) requires it; the UI will ask for it.
# Strongly recommended for any public deployment.
ACCESS_TOKEN=
